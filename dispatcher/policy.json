{
  "schema_version": "1.0",
  "meta": {
    "created": "2026-05-17",
    "last_updated": "2026-05-17",
    "description": "라우팅 정책 — AGENTS.md Step 1 의사결정 트리의 코드화",
    "default_action": {
      "type": "route",
      "target": {
        "primary": "direct"
      }
    }
  },
  "policies": [
    {
      "id": "bug_short_circuit",
      "priority": 100,
      "description": "버그/에러 발생 시 EJClaw로 즉시 라우팅 (설계 변경 불필요)",
      "match": {
        "intent": ["bug", "error", "failure"],
        "keywords": [
          "안 돼", "에러", "500", "고장", "fail", "error",
          "bug", "crash", "broken", "작동 안 함", "안됨"
        ]
      },
      "action": {
        "type": "route",
        "target": {
          "primary": "ejclaw",
          "fallback": "hermes"
        },
        "response_required": true,
        "context_policy": "include_full"
      },
      "observability": {
        "label": "short_circuit_bug"
      }
    },
    {
      "id": "new_feature",
      "priority": 90,
      "description": "신규 기능 개발 시 MetaGPT 파이프라인 실행",
      "match": {
        "intent": ["feature", "new", "development"],
        "keywords": [
          "만들어줘", "추가해줘", "구현", "개발", "create",
          "implement", "build", "개발해줘", "작성해줘"
        ]
      },
      "action": {
        "type": "pipeline",
        "steps": [
          {
            "agent": "metagpt",
            "stage": "planning",
            "mode": "PM_Architect_Engineer_Review",
            "description": "기획 → 설계 → 코드 생성 → 리뷰"
          },
          {
            "agent": "ejclaw",
            "stage": "review",
            "mode": "Owner_Reviewer_Arbiter",
            "description": "소유자 → 리뷰어 → 중재자 루프"
          },
          {
            "agent": "metagpt",
            "stage": "qa",
            "description": "테스트 실행 및 QA"
          }
        ],
        "on_step_fail": "stop_and_report",
        "response_required": true
      },
      "observability": {
        "label": "feature_pipeline"
      }
    },
    {
      "id": "code_review",
      "priority": 85,
      "description": "코드 검토/리뷰 요청",
      "match": {
        "intent": ["review", "audit"],
        "keywords": [
          "검토해줘", "리뷰", "확인해봐", "review", "check",
          "검토", "봐줘"
        ]
      },
      "action": {
        "type": "route",
        "target": {
          "primary": "ejclaw",
          "fallback": "hermes"
        },
        "response_required": true
      },
      "observability": {
        "label": "code_review"
      }
    },
    {
      "id": "complex_analysis",
      "priority": 80,
      "description": "복잡한 분석 / PDF / 이미지 처리 등 Hermes 위임",
      "match": {
        "intent": ["analysis", "pdf", "image", "extraction"],
        "keywords": [
          "분석해줘", "PDF 정리", "이미지 봐줘", "분석",
          "summarize", "analyze", "extract", "정리해줘"
        ]
      },
      "action": {
        "type": "route",
        "target": {
          "primary": "hermes",
          "fallback": "ejclaw"
        },
        "response_required": true
      },
      "observability": {
        "label": "complex_analysis"
      }
    },
    {
      "id": "trading_finance",
      "priority": 70,
      "description": "트레이딩/금융 관련 작업 (컨테이너 미활성 시 fallback)",
      "match": {
        "intent": ["trading", "finance", "stock", "investment"],
        "keywords": [
          "트레이딩", "주식", "포트폴리오", "투자",
          "stock", "portfolio", "trade", "market"
        ]
      },
      "action": {
        "type": "route",
        "target": {
          "primary": "tradingagent",
          "fallback": "hermes"
        },
        "requires_active_container": true,
        "response_required": true
      },
      "observability": {
        "label": "trading_finance"
      }
    },
    {
      "id": "recording",
      "priority": 60,
      "description": "기록/저장 요청 → Claw 직접 처리 (record.js)",
      "match": {
        "intent": ["record", "save", "memory", "store"],
        "keywords": [
          "기록해둬", "저장", "기억", "save", "record",
          "remember", "보관", "노션"
        ]
      },
      "action": {
        "type": "route",
        "target": {
          "primary": "direct"
        },
        "response_required": false,
        "auto_report": true
      },
      "observability": {
        "label": "recording"
      }
    },
    {
      "id": "strategy_review",
      "priority": 50,
      "description": "전략 검토 / 의견 요청",
      "match": {
        "intent": ["strategy", "opinion", "review"],
        "keywords": [
          "어떤 것 같아", "검토", "리뷰", "어때",
          "opinion", "think", "의견", "전략"
        ]
      },
      "action": {
        "type": "route",
        "target": {
          "primary": "direct",
          "fallback": "hermes"
        },
        "response_required": true
      },
      "observability": {
        "label": "strategy_review"
      }
    },
    {
      "id": "config_env",
      "priority": 40,
      "description": "설정/환경변수 관련 작업",
      "match": {
        "intent": ["config", "environment", "setup"],
        "keywords": [
          "API 키", "환경변수", "설정", "config",
          "token", "key", "env", "환경"
        ]
      },
      "action": {
        "type": "route",
        "target": {
          "primary": "direct"
        },
        "context_policy": "minimal"
      },
      "observability": {
        "label": "config_env"
      }
    },
    {
      "id": "default_direct",
      "priority": 1,
      "description": "매칭 실패 시 기본 처리 (Claw 직접 처리)",
      "match": {},
      "action": {
        "type": "route",
        "target": {
          "primary": "direct"
        },
        "response_required": true
      },
      "observability": {
        "label": "default_direct"
      }
    }
  ]
}
